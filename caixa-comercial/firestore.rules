rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sales/{saleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && !exists(/databases/$(database)/documents/dailyClosings/$(request.resource.data.operationDate));
      allow delete: if request.auth != null;
      allow update: if false;
    }

    match /dailyClosings/{operationDate} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.operationDate == operationDate
        && request.resource.data.closedBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
